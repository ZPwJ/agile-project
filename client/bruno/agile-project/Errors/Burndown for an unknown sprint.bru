meta {
  name: Burndown for an unknown sprint
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/analytics/sprints/999999/burndown
  body: none
  auth: inherit
}

tests {
  test("404 with the analytics error body", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("NOT_FOUND");
    expect(res.body.message).to.be.a("string").and.not.empty;
    expect(res.body).to.have.property("timestamp");
  });
}
