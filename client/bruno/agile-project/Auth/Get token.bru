meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  client_secret: {{process.env.BRUNO_CLIENT_SECRET}}
  username: {{username}}
  password: {{process.env.BRUNO_PASSWORD}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access_token);
    bru.setEnvVar("accessTokenExpiresAt", String(Date.now() + res.body.expires_in * 1000));
  }
}

tests {
  test("token issued", function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string").and.not.empty;
  });
}

docs {
  Optional: other requests fetch a token automatically (see collection.bru). Credentials come from the .env file (see .env.example). The token is stored in the secret variable accessToken.
}
