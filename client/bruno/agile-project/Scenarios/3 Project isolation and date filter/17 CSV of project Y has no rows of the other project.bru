meta {
  name: CSV of project Y has no rows of the other project
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{py}}/sprints/comparison.csv
  body: none
  auth: inherit
}

tests {
  test("one data row, no other project", function () {
    const lines = String(res.body).split("\r\n").filter(Boolean);
    expect(res.status).to.equal(200);
    expect(lines.length).to.equal(2);
    expect(lines[1]).to.contain("Sprint Y " + bru.getVar("runId"));
    expect(lines[1]).to.not.contain("Sprint X ");
  });
}
