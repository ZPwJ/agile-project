meta {
  name: Comparison of project X has only its own sprint
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{px}}/sprints/comparison
  body: none
  auth: inherit
}

tests {
  test("only project X", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
    expect(res.body[0].sprintId).to.equal(bru.getVar("sx"));
    expect(res.body[0].projectId).to.equal(bru.getVar("px"));
  });
}
