meta {
  name: Date filter around today includes the sprint
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{px}}/sprints/comparison?from={{yesterday}}&to={{tomorrow}}
  body: none
  auth: inherit
}

tests {
  test("overlapping sprint is returned (boundaries inclusive)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
  });
}
