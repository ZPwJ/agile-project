meta {
  name: Burnup of a sprint without dates
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/analytics/sprints/{{s2}}/burnup
  body: none
  auth: inherit
}

tests {
  test("no invented points, data flagged as partial", function () {
    expect(res.status).to.equal(200);
    expect(res.body.points).to.deep.equal([]);
    expect(res.body.dataCompleteness).to.equal("PARTIAL");
    expect(res.body.warnings.join(" ")).to.contain("NO_DATES");
  });
}
