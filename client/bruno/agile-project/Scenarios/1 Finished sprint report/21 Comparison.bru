meta {
  name: Comparison
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{p1}}/sprints/comparison
  body: none
  auth: inherit
}

tests {
  test("exactly this project's sprint", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
    const r = res.body[0];
    expect(r.sprintId).to.equal(bru.getVar("s1"));
    expect(r.projectId).to.equal(bru.getVar("p1"));
    expect(r.completedTasks).to.equal(1);
    expect(r.incompleteTasks).to.equal(2);
    expect(r.velocity).to.equal(5);
    expect(r.state).to.equal("FINISHED");
  });
  test("dates are in Europe/Warsaw", function () {
    expect(res.body[0].startDate).to.match(/[+-]0[12]:00$/);
  });
}
