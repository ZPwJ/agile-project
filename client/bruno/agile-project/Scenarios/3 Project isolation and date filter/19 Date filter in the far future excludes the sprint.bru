meta {
  name: Date filter in the far future excludes the sprint
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{px}}/sprints/comparison?from=2100-01-01&to=2100-12-31
  body: none
  auth: inherit
}

tests {
  test("no overlap, empty list", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal([]);
  });
}
