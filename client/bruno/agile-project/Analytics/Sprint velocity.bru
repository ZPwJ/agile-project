meta {
  name: Sprint velocity
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/analytics/sprints/{{sprintId}}/velocity
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200) { bru.setVar("velocity", res.body.velocity); }
}

tests {
  test("200 and the velocity shape", function () {
    expect(res.status).to.equal(200);
    expect(res.body.sprintId).to.equal(Number(bru.getEnvVar("sprintId")));
    expect(res.body.velocity).to.be.a("number").and.at.least(0);
    expect(res.body).to.have.property("unit");
    expect(res.body).to.have.property("state");
  });
}
