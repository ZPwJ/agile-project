meta {
  name: Comparison counts a planned sprint without tasks
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{p2}}/sprints/comparison
  body: none
  auth: inherit
}

tests {
  test("sprints without completed tasks still appear", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
    expect(res.body[0].completedTasks).to.equal(0);
    expect(res.body[0].velocity).to.equal(0);
    expect(res.body[0].startDate).to.equal(null);
  });
}
