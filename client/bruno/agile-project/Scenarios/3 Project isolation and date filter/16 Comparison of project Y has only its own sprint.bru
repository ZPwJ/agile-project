meta {
  name: Comparison of project Y has only its own sprint
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{py}}/sprints/comparison
  body: none
  auth: inherit
}

tests {
  test("only project Y", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(1);
    expect(res.body[0].sprintId).to.equal(bru.getVar("sy"));
    expect(res.body[0].projectId).to.equal(bru.getVar("py"));
  });
}
