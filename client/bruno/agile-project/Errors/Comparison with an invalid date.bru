meta {
  name: Comparison with an invalid date
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/analytics/projects/{{projectId}}/sprints/comparison?from=not-a-date
  body: none
  auth: inherit
}

tests {
  test("400 with the analytics error body", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_PARAMETER");
    expect(res.body.message).to.be.a("string").and.not.empty;
    expect(res.body).to.have.property("timestamp");
  });
}
