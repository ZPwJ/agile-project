# cp .env.example .env and fill in the values

# app database, both have to be the same
POSTGRES_PASSWORD=
SPRING_DATASOURCE_PASSWORD=

# keycloak database, both have to be the same
AUTH_DB_POSTGRES_PASSWORD=
KC_DB_PASSWORD=

# keycloak admin console (login: admin)
KEYCLOAK_ADMIN_PASSWORD=

# "secret" of the agile-project-server client from infrastructure/auth-server/realm-export.json
AUTH_SERVER_CLIENT_SECRET=

# sonarqube database
SONAR_DB_PASSWORD=
