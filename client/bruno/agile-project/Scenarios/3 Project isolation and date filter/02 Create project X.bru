meta {
  name: Create project X
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/scrum-project
  body: json
  auth: inherit
}

body:json {
  { "name": "Scenario {{runId}} X", "description": "Bruno scenario", "projectGoal": "test" }
}

script:post-response {
  if (res.status === 201) { bru.setVar("px", res.body.projectID); }
}

tests {
  test("project created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.projectID).to.be.a("number");
  });
}
