meta {
  name: Summary of an empty planned sprint
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/analytics/sprints/{{s2}}/summary
  body: none
  auth: inherit
}

tests {
  test("zero everything, no failure", function () {
    expect(res.status).to.equal(200);
    expect(res.body.state).to.equal("PLANNED");
    expect(res.body.totalTasks).to.equal(0);
    expect(res.body.velocity).to.equal(0);
    expect(res.body.startDate).to.equal(null);
  });
}
