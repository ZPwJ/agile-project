meta {
  name: Velocity
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/analytics/sprints/{{s1}}/velocity
  body: none
  auth: inherit
}

tests {
  test("only the completed, estimated task counts", function () {
    expect(res.status).to.equal(200);
    expect(res.body.velocity).to.equal(5);
    expect(res.body.state).to.equal("FINISHED");
  });
}
